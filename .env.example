# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-xxx
# The paper used Alibaba Cloud Model Studio's OpenAI-compatible API.
# This is the Beijing pay-as-you-go endpoint; use the endpoint matching the
# region and billing plan of your API key.
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=deepseek-v4-flash
# Temperature and timeout are controlled by configs/models.yaml or the
# experiment command.
